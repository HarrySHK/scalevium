NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key

# Server only — Dashboard → Settings → API Keys → Secret key (sb_secret_...) or legacy service_role JWT
SUPABASE_SERVICE_ROLE_KEY=
# Or use the new secret key name:
# SUPABASE_SECRET_KEY=

# Optional — Google Apps Script web app URL (see scripts/google-apps-script/contact-form-webhook.gs)
GOOGLE_SHEETS_WEBHOOK_URL=

# Optional — Google Analytics 4 (loads only after cookie consent)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
